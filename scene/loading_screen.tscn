[gd_scene load_steps=12 format=3 uid="uid://loading_screen_main"]

; ============================================================
;  loading_screen.tscn — Mas Arief: Ekspedisi Ciliwung
;  Godot 4  |  Resolution: 1920×1080  |  Anchors: full rect
; ============================================================

[ext_resource type="Script"        path="res://scenes/loading/loading_screen.gd"        id="1"]
[ext_resource type="Texture2D"     path="res://assets/images/background.png"            id="2"]
[ext_resource type="Texture2D"     path="res://assets/images/logo.png"                  id="3"]
[ext_resource type="AudioStream"   path="res://assets/audio/river_night_ambience.ogg"   id="6"]
[ext_resource type="Shader"        path="res://shaders/water_bar.gdshader"              id="7"]
[ext_resource type="Shader"        path="res://shaders/fog_overlay.gdshader"            id="8"]
[ext_resource type="Shader"        path="res://shaders/chromatic_aberration.gdshader"   id="9"]

; ── Shader materials ─────────────────────────────────────────
[sub_resource type="ShaderMaterial" id="ShaderMat_WaterBar"]
shader = ExtResource("7")
shader_parameter/glow_intensity  = 0.5
shader_parameter/scroll_speed    = 0.35
shader_parameter/ripple_strength = 0.018
shader_parameter/ripple_frequency = 18.0
shader_parameter/water_color_a   = Color(0.176, 0.714, 0.769, 1)
shader_parameter/water_color_b   = Color(0.471, 0.941, 1.0, 1)
shader_parameter/glow_color      = Color(0.471, 0.941, 1.0, 1)

[sub_resource type="ShaderMaterial" id="ShaderMat_Fog"]
shader = ExtResource("8")
shader_parameter/fog_speed    = 0.04
shader_parameter/fog_density  = 0.28
shader_parameter/fog_scale    = 3.5
shader_parameter/fog_color    = Color(0.55, 0.82, 0.88, 1)
shader_parameter/vertical_bias = 0.6

[sub_resource type="ShaderMaterial" id="ShaderMat_Chromatic"]
shader = ExtResource("9")
shader_parameter/strength    = 0.003
shader_parameter/pulse_speed = 0.4

; ── Fireflies particle material ───────────────────────────────
[sub_resource type="ParticleProcessMaterial" id="FirefliesMat"]
emission_shape          = 3                    ; Box
emission_box_extents    = Vector3(960, 540, 0)
direction               = Vector3(0, 0, 0)
spread                  = 180.0
gravity                 = Vector3(0, 0, 0)
initial_velocity_min    = 5.0
initial_velocity_max    = 18.0
angular_velocity_min    = -20.0
angular_velocity_max    = 20.0
scale_min               = 0.08
scale_max               = 0.22
color                   = Color(1.0, 0.95, 0.5, 0.85)
color_ramp              = null

; ── Fog particle material ─────────────────────────────────────
; NOTE: Fog is handled by the shader ColorRect; GPUParticles2D
;       below is optional supplemental mist near the waterline.
[sub_resource type="ParticleProcessMaterial" id="FogMat"]
emission_shape          = 3
emission_box_extents    = Vector3(960, 60, 0)
direction               = Vector3(1, 0, 0)
spread                  = 15.0
gravity                 = Vector3(0, -2, 0)
initial_velocity_min    = 8.0
initial_velocity_max    = 22.0
scale_min               = 2.5
scale_max               = 5.0
color                   = Color(0.55, 0.82, 0.88, 0.12)

; ─────────────────────────────────────────────────────────────
;  SCENE TREE
; ─────────────────────────────────────────────────────────────
[node name="LoadingScreen" type="Control"]
layout_mode             = 3
anchors_preset          = 15              ; Full rect
anchor_right            = 1.0
anchor_bottom           = 1.0
script                  = ExtResource("1")

; ── Background ───────────────────────────────────────────────
[node name="Background" type="TextureRect" parent="."]
